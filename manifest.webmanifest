{
  "name": "Alex HQ",
  "short_name": "Alex HQ",
  "description": "Alex's private dashboard for tasks, notes, projects, and weather.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0b0c0e",
  "theme_color": "#0b0c0e",
  "categories": ["productivity", "utilities"],
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Open tasks",
      "short_name": "Tasks",
      "url": "./#tasks",
      "icons": [{ "src": "./icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Open notes",
      "short_name": "Notes",
      "url": "./#notes",
      "icons": [{ "src": "./icon-192.png", "sizes": "192x192" }]
    }
  ]
}
