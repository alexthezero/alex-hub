{
  "name": "Alex HQ",
  "short_name": "Alex HQ",
  "description": "Alex HQ — a local-first personal field terminal for daily operations, weather, notes, and projects.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#090b0a",
  "theme_color": "#090b0a",
  "categories": ["productivity", "utilities"],
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Open tasking",
      "short_name": "Tasking",
      "url": "./#tasks",
      "icons": [{ "src": "./icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Open field log",
      "short_name": "Field log",
      "url": "./#notes",
      "icons": [{ "src": "./icon-192.png", "sizes": "192x192" }]
    }
  ]
}
